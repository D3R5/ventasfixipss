generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  rut       String   @unique
  nombre    String
  apellido  String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Product {
  id              Int      @id @default(autoincrement())
  sku             String   @unique
  nombre          String
  descripcion_corta String
  descripcion_larga String
  imagen          String?
  precio_neto     Float
  precio_venta    Float    // precio con IVA (19%)
  stock_actual    Int
  stock_minimo    Int
  stock_bajo      Int
  stock_alto      Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Client {
  id                Int      @id @default(autoincrement())
  rut_empresa       String   @unique
  rubro             String
  razon_social      String
  telefono          String
  direccion         String
  nombre_contacto   String
  email_contacto    String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}